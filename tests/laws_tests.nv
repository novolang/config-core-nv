// laws_tests.nv — the merge rules the README states, checked as
// properties over trees drawn from a fixed pseudo-random sequence.
//
// Each case builds a few hundred random layers of small tables, lists,
// scalars and nulls over a three-letter key alphabet, so keys collide
// often, and checks one rule against every path.  The sequence is the
// C standard's example `rand`, so every run draws the same trees.
//
// The rules are the README's: the later layer wins every path it sets,
// tables merge deep so a key only the lower layer holds survives, a
// list replaces whole, null replaces and does not delete, and the empty
// table changes nothing.

use std.test
use std.list
use cfgvalue
use cfglayer
use cfgmerge
use cfglookup

fn next_seed(seed: Int) -> Int
    (seed * 1103515245 + 12345) % 2147483648

fn pick(seed: Int, n: Int) -> Int
    seed / 65536 % n

// A random value no deeper than `depth`, and the seed after drawing it.
fn draw(seed: Int, depth: Int) -> (ConfigValue, Int)
    var s = next_seed(seed)
    var arm = pick(s, 6)
    if depth == 0
        arm = 2 + pick(s, 4)
    if arm == 0
        return draw_table(s, depth)
    if arm == 1
        let n = pick(next_seed(s), 3)
        s = next_seed(s)
        var items: [ConfigValue] = []
        for i in 0..n
            let got = draw(s, 0)
            list.push(items, got.0)
            s = got.1
        return (cfgvalue.list_of(items), s)
    if arm == 2
        return (cfgvalue.int_value(pick(next_seed(s), 100)), next_seed(s))
    if arm == 3
        return (cfgvalue.str_value("s${pick(next_seed(s), 10)}"), next_seed(s))
    if arm == 4
        return (cfgvalue.bool_value(pick(next_seed(s), 2) == 1), next_seed(s))
    (cfgvalue.null_value(), s)

// A random table holding each of the keys `a`, `b` and `c` or not, in
// that order.  Duplicate keys are the caller's to avoid (README rule
// 15), so the tables here have none.
fn draw_table(seed: Int, depth: Int) -> (ConfigValue, Int)
    var s = next_seed(seed)
    var pairs: [ConfigPair] = []
    for key in ["a", "b", "c"]
        s = next_seed(s)
        if pick(s, 2) == 1
            let got = draw(s, depth - 1)
            list.push(pairs, cfgvalue.pair(key, got.0))
            s = got.1
    (cfgvalue.table(pairs), s)

// A list of layers with random ranks and random table roots.
fn draw_layers(seed: Int) -> ([ConfigLayer], Int)
    var s = seed
    var ls: [ConfigLayer] = []
    let n = 1 + pick(next_seed(s), 4)
    for i in 0..n
        s = next_seed(s)
        let got = draw_table(s, 3)
        list.push(ls, cfglayer.layer("L${i}", pick(s, 3), got.0))
        s = got.1
    (ls, s)

// The value at `path` in `root`, as an optional, with duplicate keys
// resolved the way a lookup resolves them.
fn at(root: ConfigValue, path: Str) -> ?ConfigValue
    match cfglookup.value_at(root, path)
        Ok(v)  => Some(v)
        Err(_) => None

@test
fn test_the_later_layer_wins_every_path_it_holds() [io]
    var seed = 20260927
    var ok_value = true
    var ok_origin = true
    var ok_fold = true
    for k in 0..200
        let got = draw_layers(seed)
        seed = got.1
        let ls = got.0
        let m = cfgmerge.merge_all(ls)
        let ordered = cfglayer.in_order(ls)
        var folded = cfgvalue.empty_table()
        for l in ordered
            folded = cfgmerge.merge_values(folded, l.root)
        if folded != cfgmerge.root_of(m)
            ok_fold = false
        for p in cfglookup.leaf_paths(m)
            let h = cfgmerge.history_of(ls, p)
            if list.len(h) == 0
                ok_origin = false
            else
                let winner = h[list.len(h) - 1]
                match cfgmerge.origin_of(m, p)
                    Some(o) =>
                        if o.layer != winner.layer
                            ok_origin = false
                    None    =>
                        ok_origin = false
                match cfglayer.named(ls, winner.layer)
                    Some(l) =>
                        if at(l.root, p) != at(cfgmerge.root_of(m), p)
                            ok_value = false
                    None    =>
                        ok_value = false

    test.case("the merged tree is the rules folded over the layers in order")
    test.assert(ok_fold)

    test.case("every leaf's origin is the last layer in the history of that path")
    test.assert(ok_origin)

    test.case("and the merged value is that layer's value")
    test.assert(ok_value)

@test
fn test_tables_merge_deep_and_everything_else_replaces() [io]
    var seed = 7
    var ok_upper = true
    var ok_lower = true
    var ok_lists = true
    var ok_identity = true
    for k in 0..300
        let a = draw_table(seed, 3)
        let b = draw_table(a.1, 3)
        seed = b.1
        let under = a.0
        let over = b.0
        let merged = cfgmerge.merge_values(under, over)
        let mu = cfgmerge.merge_all([cfglayer.layer("under", 0, under)])
        let mo = cfgmerge.merge_all([cfglayer.layer("over", 0, over)])
        for p in cfglookup.leaf_paths(mo)
            if at(merged, p) != at(over, p)
                ok_upper = false
        for p in cfglookup.leaf_paths(mu)
            if not shadowed(under, over, p) and at(merged, p) != at(under, p)
                ok_lower = false
        for p in cfglookup.leaf_paths(mo)
            if not list_matches(over, merged, p)
                ok_lists = false
        if cfgmerge.merge_values(cfgvalue.empty_table(), under) != under
            ok_identity = false
        if cfgmerge.merge_values(under, cfgvalue.empty_table()) != under
            ok_identity = false

    test.case("every leaf of the upper table is in the merge unchanged")
    test.assert(ok_upper)

    test.case("every leaf of the lower table survives unless the upper table holds that path or a prefix of it")
    test.assert(ok_lower)

    test.case("a list the upper table holds replaces the lower one whole")
    test.assert(ok_lists)

    test.case("the empty table is the identity on both sides")
    test.assert(ok_identity)

// Whether the lower table's leaf at `path` is replaced by the upper
// table.  Walking down from the root, the first prefix the upper table
// does not hold means nothing above reaches the leaf.  A prefix both
// hold as tables merges deep and the walk goes on.  Anything else the
// upper table holds on the way, the leaf itself included, replaces
// what the lower table had.
fn shadowed(under: ConfigValue, over: ConfigValue, path: Str) -> Bool
    match cfglookup.split(path)
        Ok(segs) =>
            var prefix: [Str] = []
            for seg in segs
                list.push(prefix, seg)
                let q = cfglookup.path_of(prefix)
                match at(over, q)
                    None    =>
                        return false
                    Some(v) =>
                        let both_tables = cfgvalue.is_table(v) and is_table_at(under, q)
                        if not both_tables or list.len(prefix) == list.len(segs)
                            return true
            true
        Err(_)   => false

fn is_table_at(root: ConfigValue, path: Str) -> Bool
    match at(root, path)
        Some(v) => cfgvalue.is_table(v)
        None    => false

// Whether every list the upper table holds on the way to `path` is in
// the merge whole: the same items, none added from the lower table.
fn list_matches(over: ConfigValue, merged: ConfigValue, path: Str) -> Bool
    match cfglookup.split(path)
        Ok(segs) =>
            var prefix: [Str] = []
            for seg in segs
                list.push(prefix, seg)
                let q = cfglookup.path_of(prefix)
                if let Some(v) = at(over, q)
                    if cfgvalue.kind_of(v) == KindList and at(merged, q) != Some(v)
                        return false
            true
        Err(_)   => false
