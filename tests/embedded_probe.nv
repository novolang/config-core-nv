// embedded_probe.nv — the value tree, the merge and the typed getters
// on a microcontroller, as firmware that builds for a Cortex-M, boots
// there and checks its answers.
//
// `scripts/shard_audit.sh`'s `core-embedded` row copies this file and
// the modules it reaches through `use`, transitively, into a package of
// its own and runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a Cortex-M4 ELF or fails.  The same ELF boots under
//
//   qemu-system-arm -machine mps2-an386 -nographic -semihosting -kernel probe.elf
//
// and writes `PASS: config-core-embedded` when every check holds.
//
// A firmware image carries a settings table built at compile time: a
// radio channel, a sample interval, calibration constants.  A field
// update received over the air is a second layer on top of it.  Reading
// a setting is the same question a server asks of a file.
//
// The modules are `@tier(rt)`: the tree is made of lists and strings,
// so it needs the device's heap.  `cfgenvkeys` is not here, because a
// device has no environment to read.

use cfgvalue
use cfglayer
use cfgmerge
use cfglookup
use cfgfault

// The settings the firmware ships with, and an update that changes the
// channel and clears the name.
@tier(rt)
fn settings() -> MergedConfig
    let radio = cfgvalue.table([
        cfgvalue.pair("chan", cfgvalue.int_value(37)),
        cfgvalue.pair("power", cfgvalue.int_value(0 - 4))])
    let built_in = cfglayer.layer("flash", 0, cfgvalue.table([
        cfgvalue.pair("radio", radio),
        cfgvalue.pair("interval_ms", cfgvalue.int_value(1000)),
        cfgvalue.pair("name", cfgvalue.str_value("sensor-1"))]))
    let update = cfglayer.layer("update", 10, cfgvalue.table([
        cfgvalue.pair("radio", cfgvalue.table([cfgvalue.pair("chan", cfgvalue.int_value(11))])),
        cfgvalue.pair("name", cfgvalue.null_value())]))
    cfgmerge.merge_all([built_in, update])

// Every answer this probe checks, counted, so a device that disagrees
// with the host says how many it lost.
@tier(rt)
fn score() -> Int
    let m = settings()
    var n = 0
    // The update won the channel, and the power the update did not
    // mention survived from flash.
    if int_at(m, "radio.chan") == 11
        n = n + 1
    if int_at(m, "radio.power") == 0 - 4
        n = n + 1
    // The update cleared the name, which is not the same as absent.
    if cfgfault.presence_name(cfglookup.presence(m, "name")) == "null"
        n = n + 1
    // A wrong kind is refused and names the layer that set it.
    if let Err(e) = cfglookup.get_str(m, "interval_ms")
        if cfgfault.fault_layer(e) == Some("flash")
            n = n + 1
    // The path grammar and the provenance record.
    if cfglookup.path_of(["radio", "chan"]) == "radio.chan"
        n = n + 1
    if cfgmerge.origin_of(m, "radio.chan") != None
        n = n + 1
    n

// The integer at `path`, or 0 when the getter refuses.
@tier(rt)
fn int_at(m: MergedConfig, path: Str) -> Int
    match cfglookup.get_int(m, path)
        Ok(v)  => v
        Err(_) => 0

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    if score() == 6
        hal.uart.write("PASS: config-core-embedded\n")
    else
        hal.uart.write("FAIL: config-core-embedded\n")
    loop
        core.rt.sleep_ms(1000)
