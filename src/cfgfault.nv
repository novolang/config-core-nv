// cfgfault.nv — why a lookup said no, and whether a key is there at
// all.
//
// A refusal answers three questions:
//
//   what   — missing, wrong type, walked through a scalar, bad path,
//            set to null
//   where  — the dotted path, exactly as it was asked for
//   whose  — the layer whose value the answer came from
//
// The third is the one that sends a reader to the right file.
// `database.port` being a string is rarely a mistake in the file the
// author is looking at; it is usually an environment variable they
// forgot they exported.  Every arm that had a value to look at carries
// the layer that supplied it.
//
// A fault is a value with fields.  `message` renders one line for a
// program that has nothing better to say, and a program that wants its
// own wording reads the fields.
//
// Every function here is `@tier(rt)`.

use cfgvalue

// Why a lookup refused.
//
// ```novo
// use cfgfault
//
// fn main() [io]
//     println(cfgfault.fault_path(CfgMissing("server.port")))
// ```
pub enum ConfigFault
    // No layer set this path.  A program that treated this the same
    // as `CfgWasNull` could not let a layer clear an inherited
    // setting.
    CfgMissing(path: Str)
    // A value is there and it is the wrong shape.  `wanted` is what
    // the getter asked for, `found` is what the merged tree holds, and
    // `layer` is the name of the layer that won the path.
    CfgWrongType(path: Str, wanted: ConfigKind, found: ConfigKind, layer: Str)
    // The walk met a value it could not go into part way down:
    // `server.port.timeout` where `server.port` is an integer.  `at` is
    // the prefix that stopped it, `"server.port"`, so a message can
    // point at the level that is wrong.  `found` is that value's kind
    // and `layer` the layer that set it.
    CfgNotATable(path: Str, at: Str, found: ConfigKind, layer: Str)
    // The path itself does not parse.  `why` is one of `"empty path"`,
    // `"empty segment"`, `"dangling escape"` (a backslash at the end)
    // and `"unknown escape"` (a backslash before anything but a dot or
    // a backslash).
    CfgBadPath(path: Str, why: Str)
    // The path is set to null by `layer`.  A getter refuses with this
    // rather than `CfgMissing`, because a caller deciding whether to
    // fall back to a default needs to know that a layer said "no
    // value" on purpose.
    CfgWasNull(path: Str, layer: Str)

// Whether a key is there, and how.
//
// The typed getters answer "give me an int".  This answers "is there
// anything, and who put it there", which is the question a caller asks
// before choosing between a default and a refusal.
//
// ```novo
// use cfgfault
//
// fn main() [io]
//     println(cfgfault.presence_name(KeyAbsent))
// ```
pub enum KeyPresence
    // No layer mentions the path.
    KeyAbsent
    // The winning layer set it to null on purpose.
    KeyWasNull(layer: Str)
    // The winning layer set it to a value of this kind.
    KeyHeld(kind: ConfigKind, layer: Str)

// The reason, as one line of text: the path, then what is wrong, then
// the layer when there is one.
//
// `Result<_, ConfigFault>` requires the `Error` trait (SPEC section
// 3.4), and this is what a `!` propagation prints when nothing catches
// it.  A program that wants to point at the layer reads `fault_layer`,
// and one that groups refusals reads `fault_kind`.
impl Error for ConfigFault
    // `server.port: wanted int, found str, set by APP_ environment`.
    @tier(rt)
    fn message(self) -> Str
        match self
            CfgMissing(path)                         => "${path}: no layer sets it"
            CfgWrongType(path, wanted, found, layer) =>
                "${path}: wanted ${cfgvalue.kind_name(wanted)}, found ${cfgvalue.kind_name(found)}${blame(layer)}"
            CfgNotATable(path, at, found, layer)     =>
                "${path}: ${at} is ${cfgvalue.kind_name(found)}, which has no fields${blame(layer)}"
            CfgBadPath(path, why)                    => "${path}: not a path: ${why}"
            CfgWasNull(path, layer)                  => "${path}: set to null${blame(layer)}"

// The path a fault is about, for every arm.
//
// ```novo
// use cfgfault
//
// fn main() [io]
//     println(cfgfault.fault_path(CfgBadPath("a..b", "empty segment")))
// ```
pub @tier(rt)
fn fault_path(f: ConfigFault) -> Str
    match f
        CfgMissing(path)            => path
        CfgWrongType(path, _, _, _) => path
        CfgNotATable(path, _, _, _) => path
        CfgBadPath(path, _)         => path
        CfgWasNull(path, _)         => path

// The layer a fault blames, when it had one to blame.
//
// `None` for `CfgMissing`, where no layer set the path, and for
// `CfgBadPath`, where the path never reached a layer.  A fault from
// `cfglookup.value_at`, which walks a tree with no layers, carries an
// empty layer name, and that is `None` too.
//
// ```novo
// use cfgfault
//
// fn main() [io]
//     match cfgfault.fault_layer(CfgMissing("a.b"))
//         Some(l) => println(l)
//         None    => println("nothing set it")
// ```
pub @tier(rt)
fn fault_layer(f: ConfigFault) -> ?Str
    match f
        CfgWrongType(_, _, _, layer) => named(layer)
        CfgNotATable(_, _, _, layer) => named(layer)
        CfgWasNull(_, layer)         => named(layer)
        _                            => None

// A short name for which refusal this is, for a program that groups
// or counts them.
//
// The five names are `"missing"`, `"wrong type"`, `"not a table"`,
// `"bad path"` and `"was null"`, stable across releases.
//
// ```novo
// use cfgfault
//
// fn main() [io]
//     println(cfgfault.fault_kind(CfgMissing("a")))
// ```
pub @tier(rt)
fn fault_kind(f: ConfigFault) -> Str
    match f
        CfgMissing(_)            => "missing"
        CfgWrongType(_, _, _, _) => "wrong type"
        CfgNotATable(_, _, _, _) => "not a table"
        CfgBadPath(_, _)         => "bad path"
        CfgWasNull(_, _)         => "was null"

// The name of a presence answer: `"absent"`, `"null"`, `"held"`.
//
// ```novo
// use cfgfault
//
// fn main() [io]
//     println(cfgfault.presence_name(KeyWasNull("environment")))
// ```
pub @tier(rt)
fn presence_name(p: KeyPresence) -> Str
    match p
        KeyAbsent     => "absent"
        KeyWasNull(_) => "null"
        KeyHeld(_, _) => "held"

// The layer behind a presence answer, when there is one.
//
// ```novo
// use cfgfault
//
// fn main() [io]
//     match cfgfault.presence_layer(KeyHeld(KindInt, "defaults"))
//         Some(l) => println(l)
//         None    => println("nothing set it")
// ```
pub @tier(rt)
fn presence_layer(p: KeyPresence) -> ?Str
    match p
        KeyAbsent         => None
        KeyWasNull(layer) => Some(layer)
        KeyHeld(_, layer) => Some(layer)

// Whether a presence answer means there is a usable value: `KeyHeld`
// only.
//
// `KeyWasNull` is false, because a layer that set null said there is
// no value.
//
// ```novo
// use cfgfault
//
// fn main() [io]
//     println("${cfgfault.is_held(KeyWasNull("file"))}")
// ```
pub @tier(rt)
fn is_held(p: KeyPresence) -> Bool
    match p
        KeyHeld(_, _) => true
        _             => false

// A layer name as an optional: `None` for the empty name a bare-tree
// walk records.
@tier(rt)
fn named(layer: Str) -> ?Str
    if layer == ""
        return None
    Some(layer)

// `, set by <layer>` for a message, or nothing when there is no layer.
@tier(rt)
fn blame(layer: Str) -> Str
    if layer == ""
        return ""
    ", set by ${layer}"
