// cfglookup.nv — dotted paths, and the typed getters that refuse with
// a reason.
//
// The path grammar:
//
//   a path is one or more segments joined by `.`
//   a segment that is only digits indexes a list
//   `\.` inside a segment is a literal dot, `\\` a literal backslash
//
// So `server.hosts.0` is the first host, and `log.my\.app.level` is the
// key `my.app` inside `log`.  There are no quotes.  The grammar
// round-trips: `path_of(split(p))` is `p` for every path `split`
// accepts.
//
// A numeric segment against a table reads the table's key `"0"`,
// because a TOML table may have a key spelled that way.  The segment is
// an index only where the value at that level is a list, and only in
// its plain decimal spelling: `hosts.007` is missing.
//
// The getters do not coerce.  `get_int` on `CfgStr("8080")` is
// `CfgWrongType`, naming the layer that supplied the string.  The one
// coercion in the package is `cfgvalue.infer_scalar`, applied where a
// layer is built from text, so a provenance answer shows that the
// environment layer holds an int.
//
// Every function here is `@tier(rt)`.

use std.str
use cfgvalue
use cfgfault
use cfgmerge

// Split a path into its segments, applying the escapes.
//
// `CfgBadPath` for an empty path, an empty segment (`a..b`, a leading
// or trailing dot), a backslash at the end of the path, or a backslash
// before anything but a dot or a backslash.
//
// ```novo
// use cfglookup
// use std.list
//
// fn main() [io]
//     match cfglookup.split("server.port")
//         Ok(segs) => println("${list.len(segs)}")
//         Err(_)   => println("bad path")
// ```
pub @tier(rt)
fn split(path: Str) -> Result<[Str], ConfigFault>
    let n = str.len(path)
    if n == 0
        return Err(CfgBadPath(path, "empty path"))
    var segs: [Str] = []
    var cur = ""
    var start = 0
    var skip = false
    for i in 0..n
        if skip
            skip = false
            continue
        let b = str.byte_at_or(path, i, 0)
        if b == '\\'
            if i + 1 >= n
                return Err(CfgBadPath(path, "dangling escape"))
            let next = str.byte_at_or(path, i + 1, 0)
            if next != '.' and next != '\\'
                return Err(CfgBadPath(path, "unknown escape"))
            cur = cur + str.slice(path, start, i) + str.from_byte(next)
            start = i + 2
            skip = true
        else if b == '.'
            let seg = cur + str.slice(path, start, i)
            if seg == ""
                return Err(CfgBadPath(path, "empty segment"))
            list.push(segs, seg)
            cur = ""
            start = i + 1
    let last = cur + str.slice(path, start, n)
    if last == ""
        return Err(CfgBadPath(path, "empty segment"))
    list.push(segs, last)
    Ok(segs)

// Join segments into a path, escaping the dots and backslashes in
// them.
//
// The inverse of `split` on every input `split` accepts.
//
// ```novo
// use cfglookup
//
// fn main() [io]
//     println(cfglookup.path_of(["log", "my.app", "level"]))
// ```
pub @tier(rt)
fn path_of(segments: [Str]) -> Str
    var out = ""
    for i in 0..list.len(segments)
        if i > 0
            out = out + "."
        out = out + str.replace(str.replace(segments[i], "\\", "\\\\"), ".", "\\.")
    out

// The value at a path, or the reason there is none.
//
// The walk every typed getter is written on.  Its refusals are the
// three shapes of "not there": `CfgBadPath` before the tree is
// touched, `CfgNotATable` part way down, and `CfgMissing` at the end.
// An index past the end of a list is `CfgMissing`.
//
// ```novo
// use cfglookup
// use cfgmerge
//
// fn main() [io]
//     match cfglookup.get_value(cfgmerge.empty(), "server.port")
//         Ok(_)  => println("found")
//         Err(e) => println(cfgfault.fault_kind(e))
// ```
pub @tier(rt)
fn get_value(m: MergedConfig, path: Str) -> Result<ConfigValue, ConfigFault>
    walk(m.root, path, m)

// Whether a path is set, and by whom.
//
// The question to ask before a default.  `KeyAbsent` means nothing
// mentioned it, and a default is right.  `KeyWasNull` means a layer
// cleared it on purpose, and a default would undo that.  A path that
// does not parse, or that walks through a scalar, is `KeyAbsent`.
//
// ```novo
// use cfglookup
// use cfgmerge
// use cfgfault
//
// fn main() [io]
//     println(cfgfault.presence_name(cfglookup.presence(cfgmerge.empty(), "a.b")))
// ```
pub @tier(rt)
fn presence(m: MergedConfig, path: Str) -> KeyPresence
    match get_value(m, path)
        Ok(CfgNull) => KeyWasNull(layer_at(m, path))
        Ok(v)       => KeyHeld(cfgvalue.kind_of(v), layer_at(m, path))
        Err(_)      => KeyAbsent

// A string at a path.
//
// `CfgWrongType` for any other kind and `CfgWasNull` for null, each
// naming the layer that set it.
//
// ```novo
// use cfglookup
// use cfgmerge
//
// fn main() [io]
//     match cfglookup.get_str(cfgmerge.empty(), "server.host")
//         Ok(s)  => println(s)
//         Err(_) => println("no host")
// ```
pub @tier(rt)
fn get_str(m: MergedConfig, path: Str) -> Result<Str, ConfigFault>
    match typed(m, path, KindStr)!
        CfgStr(s) => Ok(s)
        other     => Err(wrong(m, path, KindStr, other))

// An integer at a path.
//
// A `CfgFloat` is refused, even one whose fraction is zero: a layer
// that wrote `8080.0` where a port was wanted is a mistake worth
// hearing about.
//
// ```novo
// use cfglookup
// use cfgmerge
//
// fn main() [io]
//     match cfglookup.get_int(cfgmerge.empty(), "server.port")
//         Ok(n)  => println("${n}")
//         Err(_) => println("no port")
// ```
pub @tier(rt)
fn get_int(m: MergedConfig, path: Str) -> Result<Int, ConfigFault>
    match typed(m, path, KindInt)!
        CfgInt(n) => Ok(n)
        other     => Err(wrong(m, path, KindInt, other))

// A float at a path.
//
// A `CfgInt` is accepted and widened.  This is the one asymmetry:
// `timeout = 30` in a file whose author meant seconds should not refuse
// a float getter.
//
// ```novo
// use cfglookup
// use cfgmerge
//
// fn main() [io]
//     match cfglookup.get_float(cfgmerge.empty(), "timeout")
//         Ok(f)  => println("${f}")
//         Err(_) => println("no timeout")
// ```
pub @tier(rt)
fn get_float(m: MergedConfig, path: Str) -> Result<Float, ConfigFault>
    match typed(m, path, KindFloat)!
        CfgFloat(f) => Ok(f)
        CfgInt(n)   => Ok(n as Float)
        other       => Err(wrong(m, path, KindFloat, other))

// A boolean at a path.
//
// `CfgStr("true")` is refused.  `cfgvalue.infer_scalar` turns the
// environment's text into a `CfgBool`, when the layer is built.
//
// ```novo
// use cfglookup
// use cfgmerge
//
// fn main() [io]
//     match cfglookup.get_bool(cfgmerge.empty(), "debug")
//         Ok(b)  => println("${b}")
//         Err(_) => println("not set")
// ```
pub @tier(rt)
fn get_bool(m: MergedConfig, path: Str) -> Result<Bool, ConfigFault>
    match typed(m, path, KindBool)!
        CfgBool(b) => Ok(b)
        other      => Err(wrong(m, path, KindBool, other))

// A list at a path, as values.
//
// ```novo
// use cfglookup
// use cfgmerge
// use std.list
//
// fn main() [io]
//     match cfglookup.get_list(cfgmerge.empty(), "server.hosts")
//         Ok(xs) => println("${list.len(xs)}")
//         Err(_) => println("no hosts")
// ```
pub @tier(rt)
fn get_list(m: MergedConfig, path: Str) -> Result<[ConfigValue], ConfigFault>
    match typed(m, path, KindList)!
        CfgList(items) => Ok(items[:])
        other          => Err(wrong(m, path, KindList, other))

// A list of strings at a path.
//
// Refuses the whole list if any element is not a string, naming the
// path of the element, such as `server.hosts.2`: a list that is mostly
// strings is the common shape of a hand-edited mistake.
//
// ```novo
// use cfglookup
// use cfgmerge
// use std.list
//
// fn main() [io]
//     match cfglookup.get_str_list(cfgmerge.empty(), "server.hosts")
//         Ok(xs) => println("${list.len(xs)}")
//         Err(e) => println(cfgfault.fault_path(e))
// ```
pub @tier(rt)
fn get_str_list(m: MergedConfig, path: Str) -> Result<[Str], ConfigFault>
    let items = get_list(m, path)!
    var out: [Str] = []
    for i in 0..list.len(items)
        match items[i]
            CfgStr(s) => list.push(out, s)
            other     =>
                return Err(CfgWrongType("${path}.${i}", KindStr, cfgvalue.kind_of(other), layer_at(m, path)))
    Ok(out)

// A table at a path, as its pairs.
//
// For a program that reads a whole section, such as a map of log
// levels by module name, without knowing the keys in advance.
//
// ```novo
// use cfglookup
// use cfgmerge
// use std.list
//
// fn main() [io]
//     match cfglookup.get_table(cfgmerge.empty(), "log.levels")
//         Ok(ps) => println("${list.len(ps)}")
//         Err(_) => println("no levels")
// ```
pub @tier(rt)
fn get_table(m: MergedConfig, path: Str) -> Result<[ConfigPair], ConfigFault>
    match typed(m, path, KindTable)!
        CfgTable(pairs) => Ok(pairs[:])
        other           => Err(wrong(m, path, KindTable, other))

// Every path in the merged tree that holds a scalar or null, in tree
// order.
//
// This is what a `--dump-config` prints.  Tables and lists are not
// listed as paths of their own; a list's elements are, with their
// numeric segments, so every line names something a getter can fetch.
//
// ```novo
// use cfglookup
// use cfgmerge
// use std.list
//
// fn main() [io]
//     println("${list.len(cfglookup.leaf_paths(cfgmerge.empty()))}")
// ```
pub @tier(rt)
fn leaf_paths(m: MergedConfig) -> [Str]
    var out: [Str] = []
    leaves(cfgmerge.root_of(m), "", out)
    out

// The same walk against a bare tree, for a caller with no layers.
//
// The refusals are the same, with an empty layer name where a merged
// lookup would name the layer, because there is no layer to name.
//
// ```novo
// use cfglookup
// use cfgvalue
//
// fn main() [io]
//     match cfglookup.value_at(cfgvalue.empty_table(), "a.b")
//         Ok(_)  => println("found")
//         Err(_) => println("absent")
// ```
pub @tier(rt)
fn value_at(root: ConfigValue, path: Str) -> Result<ConfigValue, ConfigFault>
    walk(root, path, cfgmerge.empty())

// A tree with one path set, creating the tables on the way down.
//
// A host turns a flat list of `(path, value)` pairs, which is what the
// environment and the command line both are, into a layer's tree with
// this.  A scalar in the way is replaced by a table, following merge
// rule 4, so the result is always the tree the last write asked for.
// A numeric segment against a list replaces that element when it is in
// range; otherwise the list is replaced by a table too.  A `root` that
// is not a table becomes one.
//
// ```novo
// use cfglookup
// use cfgvalue
//
// fn main() [io]
//     match cfglookup.with_path(cfgvalue.empty_table(), "server.port", cfgvalue.int_value(80))
//         Ok(t)  => println("${cfgvalue.len_of(t)}")
//         Err(_) => println("bad path")
// ```
pub @tier(rt)
fn with_path(root: ConfigValue, path: Str, v: ConfigValue) -> Result<ConfigValue, ConfigFault>
    let segs = split(path)!
    Ok(set_in(root, segs, 0, v))

// The walk under `get_value` and `value_at`.  `m` supplies the layer a
// refusal names; a bare tree walks with `cfgmerge.empty()`, whose
// record names no layer.
@tier(rt)
fn walk(root: ConfigValue, path: Str, m: MergedConfig) -> Result<ConfigValue, ConfigFault>
    let segs = split(path)!
    var cur = root
    var at = ""
    for seg in segs
        match cur
            CfgTable(_)    =>
                match cfgvalue.field(cur, seg)
                    Some(next) =>
                        cur = next
                    None       =>
                        return Err(CfgMissing(path))
            CfgList(items) =>
                if not is_index(seg)
                    return Err(CfgNotATable(path, at, KindList, layer_at(m, at)))
                let i = index_in(items, seg)
                if i < 0
                    return Err(CfgMissing(path))
                cur = items[i]
            _              =>
                return Err(CfgNotATable(path, at, cfgvalue.kind_of(cur), layer_at(m, at)))
        at = extended(at, seg)
    Ok(cur)

// The value at `path`, refused as `CfgWasNull` when it is null.  The
// caller checks the kind.
@tier(rt)
fn typed(m: MergedConfig, path: Str, wanted: ConfigKind) -> Result<ConfigValue, ConfigFault>
    let v = get_value(m, path)!
    if cfgvalue.is_null(v)
        return Err(CfgWasNull(path, layer_at(m, path)))
    Ok(v)

// The refusal for a value of the wrong kind at `path`.
@tier(rt)
fn wrong(m: MergedConfig, path: Str, wanted: ConfigKind, found: ConfigValue) -> ConfigFault
    CfgWrongType(path, wanted, cfgvalue.kind_of(found), layer_at(m, path))

// The name of the layer that set `path`, or `""` when the record has
// none.
@tier(rt)
fn layer_at(m: MergedConfig, path: Str) -> Str
    match cfgmerge.origin_of(m, path)
        Some(o) => o.layer
        None    => ""

// `prefix` with one more segment, escaped as `path_of` escapes it.
@tier(rt)
fn extended(prefix: Str, seg: Str) -> Str
    if prefix == ""
        return path_of([seg])
    prefix + "." + path_of([seg])

// Whether a segment is only decimal digits, which is what makes it an
// index against a list.
@tier(rt)
fn is_index(seg: Str) -> Bool
    for i in 0..str.len(seg)
        let b = str.byte_at_or(seg, i, 0)
        if b < '0' or b > '9'
            return false
    str.len(seg) > 0

// The index of `items` that `seg` spells in decimal, or -1.  `007` and
// an index past the end spell none, so they read as missing.
@tier(rt)
fn index_in(items: [ConfigValue], seg: Str) -> Int
    if let Some(k) = str.to_int(seg)
        if k >= 0 and k < list.len(items) and str.from_int(k) == seg
            return k
    0 - 1

// Every path under `v` that holds a scalar or null, written into `out`.
@tier(rt)
fn leaves(v: ConfigValue, prefix: Str, var out: [Str])
    match v
        CfgTable(pairs) =>
            for p in pairs
                leaves(p.value, extended(prefix, p.key), out)
        CfgList(items)  =>
            for i in 0..list.len(items)
                leaves(items[i], extended(prefix, str.from_int(i)), out)
        _               => list.push(out, prefix)

// `node` with the value at `segs[i..]` set to `v`, creating or
// replacing the tables on the way down.
@tier(rt)
fn set_in(node: ConfigValue, segs: [Str], i: Int, v: ConfigValue) -> ConfigValue
    if i == list.len(segs)
        return v
    let seg = segs[i]
    match node
        CfgTable(pairs) =>
            var out = pairs[:]
            for k in 0..list.len(out)
                if out[k].key == seg
                    out[k] = cfgvalue.pair(seg, set_in(out[k].value, segs, i + 1, v))
                    return CfgTable(out)
            list.push(out, cfgvalue.pair(seg, set_in(cfgvalue.empty_table(), segs, i + 1, v)))
            CfgTable(out)
        CfgList(items)  =>
            let k = index_in(items, seg)
            if k >= 0
                var out = items[:]
                out[k] = set_in(items[k], segs, i + 1, v)
                return CfgList(out)
            set_in(cfgvalue.empty_table(), segs, i, v)
        _               => set_in(cfgvalue.empty_table(), segs, i, v)
