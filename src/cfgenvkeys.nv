// cfgenvkeys.nv — environment-variable names as a pure function over
// paths, in both directions.
//
// Nothing here reads the environment.  The host looks the names up
// and hands this module a list of `(name, value)` pairs, which also
// makes the mapping testable with nothing exported.
//
// Both directions are here, and the second is the one a host uses: the
// standard library reads one environment variable by name and cannot
// list them all.  A host therefore turns each path its program
// understands into a name with `name_for` and looks that name up.
// `map_name` is the inverse.
//
// The default mapping:
//
//   APP_SERVER__PORT  ->  server.port      prefix "APP_", separator "__"
//   APP_DEBUG         ->  debug
//   OTHER_THING       ->  (not ours; skipped)
//
// The separator is not `.`, because a shell will not export a name with
// a dot in it, and it is two underscores, so a single underscore stays
// part of a key: `APP_LOG__MAX_SIZE` is `log.max_size`.
//
// These functions are for a host with an environment, and are not part
// of the build for a microcontroller.

use std.str
use cfgvalue
use cfglayer
use cfglookup

// How environment names and dotted paths correspond.
//
// ```novo
// use cfgenvkeys
//
// fn main() [io]
//     let r = cfgenvkeys.rule("APP_")
//     println(r.separator)
// ```
pub struct EnvKeyRule
    // The prefix a name must carry to be mapped.  `""` claims every
    // name, which a container occasionally wants.
    prefix: Str
    // What stands for a dot in a name.  `"__"` by default.
    separator: Str
    // Whether the path segments are lowercased.  True by default:
    // environment names are conventionally upper case and configuration
    // keys are not, and without it `APP_PORT` and a file's `port` would
    // be two different settings.
    lowercase: Bool
    // When set, a value is split on this string into a list, so
    // `APP_HOSTS=a,b` becomes a list of two strings.  An empty value is
    // the empty list.  `None` by default, because a value that happens
    // to contain a comma is commoner than a list.
    list_separator: ?Str
    // Whether a value's text, or each item of a split value, is typed
    // by `cfgvalue.infer_scalar`.  True by default, so `APP_PORT=8080`
    // reaches `get_int`.  Set false to keep every value a string.
    infer_scalars: Bool

// The default rule for a prefix: `"__"` as the separator, lowercased
// segments, no list splitting, scalars inferred.
//
// ```novo
// use cfgenvkeys
//
// fn main() [io]
//     println("${cfgenvkeys.rule("APP_").lowercase}")
// ```
pub fn rule(prefix: Str) -> EnvKeyRule
    EnvKeyRule { prefix: prefix,
        separator: "__",
        lowercase: true,
        list_separator: None,
        infer_scalars: true }

// The dotted path an environment name maps to, or `None` when the
// name does not carry the prefix, has nothing after it, or has an empty
// segment between two separators.
//
// A segment that contains a dot or a backslash is escaped as
// `cfglookup.path_of` escapes it, so the answer is always a path
// `cfglookup.split` accepts.
//
// ```novo
// use cfgenvkeys
//
// fn main() [io]
//     match cfgenvkeys.map_name(cfgenvkeys.rule("APP_"), "APP_SERVER__PORT")
//         Some(p) => println(p)
//         None    => println("not ours")
// ```
pub fn map_name(r: EnvKeyRule, name: Str) -> ?Str
    if skip_reason(r, name) != ""
        return None
    var segs: [Str] = []
    for part in str.split(str.slice(name, str.len(r.prefix), str.len(name)), r.separator)
        if r.lowercase
            list.push(segs, str.lower(part))
        else
            list.push(segs, part)
    Some(cfglookup.path_of(segs))

// The environment name a dotted path maps to.
//
// A host looks each answer up, because the standard library reads the
// environment by name and cannot list it.
//
// The inverse of `map_name`.  A segment may hold ASCII letters, digits
// and underscores.  A path gives `None` rather than a mangled name when
// a segment holds anything else, since a shell will not export `a-b`,
// or when `map_name` would not give the same path back: an upper-case
// letter under a lowercasing rule, or a segment that contains the
// separator or begins or ends with part of it.
//
// ```novo
// use cfgenvkeys
//
// fn main() [io]
//     match cfgenvkeys.name_for(cfgenvkeys.rule("APP_"), "server.port")
//         Some(n) => println(n)
//         None    => println("no name for that path")
// ```
pub fn name_for(r: EnvKeyRule, path: Str) -> ?Str
    match cfglookup.split(path)
        Ok(segs) =>
            var parts: [Str] = []
            for seg in segs
                if not exportable(seg)
                    return None
                if r.lowercase
                    list.push(parts, str.upper(seg))
                else
                    list.push(parts, seg)
            let name = r.prefix + str.join(parts, r.separator)
            if map_name(r, name) == Some(path)
                return Some(name)
            None
        Err(_)   => None

// Every name a list of paths maps to, skipping the ones that have
// none.
//
// `name_for` over a list, which is the call shape a host wants.
//
// ```novo
// use cfgenvkeys
// use std.list
//
// fn main() [io]
//     let ns = cfgenvkeys.names_for(cfgenvkeys.rule("APP_"), ["server.port", "debug"])
//     println("${list.len(ns)}")
// ```
pub fn names_for(r: EnvKeyRule, paths: [Str]) -> [Str]
    var out: [Str] = []
    for p in paths
        if let Some(n) = name_for(r, p)
            list.push(out, n)
    out

// A layer from a list of `(name, value)` pairs.
//
// A pair whose name `map_name` does not map is skipped.  Each other
// pair sets one path in the layer's tree, split by `list_separator` and
// typed by `infer_scalars` under the rule.  A later pair that maps to
// a path an earlier one set replaces it, which is what a shell does
// when a variable is exported twice.
//
// ```novo
// use cfgenvkeys
// use cfgmerge
// use cfgvalue
//
// fn main() [io]
//     let r = cfgenvkeys.rule("APP_")
//     let l = cfgenvkeys.layer_from(r, [("APP_SERVER__PORT", "8080")], "APP_ environment", 30)
//     println("${cfgvalue.len_of(l.root)}")
// ```
pub fn layer_from(r: EnvKeyRule, pairs: [(Str, Str)], name: Str, rank: Int) -> ConfigLayer
    var root = cfgvalue.empty_table()
    for pr in pairs
        if let Some(p) = map_name(r, pr.0)
            root = with_value(root, p, value_for(r, pr.1))
    cfglayer.layer(name, rank, root)

// The names `layer_from` would skip, each paired with the reason.
//
// The reason is one of `"no prefix"`, `"nothing after the prefix"` and
// `"empty segment"`.  A `--explain-config` prints these, because a
// name that maps to nothing produces no error.
//
// ```novo
// use cfgenvkeys
// use std.list
//
// fn main() [io]
//     let r = cfgenvkeys.rule("APP_")
//     println("${list.len(cfgenvkeys.skipped_names(r, [("PATH", "/bin")]))}")
// ```
pub fn skipped_names(r: EnvKeyRule, pairs: [(Str, Str)]) -> [(Str, Str)]
    var out: [(Str, Str)] = []
    for pr in pairs
        let why = skip_reason(r, pr.0)
        if why != ""
            list.push(out, (pr.0, why))
    out

// A layer from a list of `(path, value)` pairs, with no name mapping
// at all.
//
// This is the command line's shape: `--set server.port=8080` is
// already a path, used as written.  Values are typed by
// `cfgvalue.infer_scalar`, the rule the environment uses, because both
// sources are text.  A later pair replaces an earlier one at the same
// path.
//
// A path that does not parse is skipped and reported by `bad_paths`, so
// one bad flag does not lose the good ones.
//
// ```novo
// use cfgenvkeys
// use cfgvalue
//
// fn main() [io]
//     let l = cfgenvkeys.layer_from_paths([("server.port", "8080")], "--set", 40)
//     println("${cfgvalue.len_of(l.root)}")
// ```
pub fn layer_from_paths(pairs: [(Str, Str)], name: Str, rank: Int) -> ConfigLayer
    var root = cfgvalue.empty_table()
    for pr in pairs
        root = with_value(root, pr.0, cfgvalue.infer_scalar(pr.1))
    cfglayer.layer(name, rank, root)

// The paths `layer_from_paths` could not parse, with the fault for
// each.
//
// ```novo
// use cfgenvkeys
// use std.list
//
// fn main() [io]
//     println("${list.len(cfgenvkeys.bad_paths([("a..b", "1")]))}")
// ```
pub fn bad_paths(pairs: [(Str, Str)]) -> [ConfigFault]
    var out: [ConfigFault] = []
    for pr in pairs
        if let Err(e) = cfglookup.split(pr.0)
            list.push(out, e)
    out

// Why `map_name` would not map `name`, or `""` when it would.
fn skip_reason(r: EnvKeyRule, name: Str) -> Str
    if not str.starts_with(name, r.prefix)
        return "no prefix"
    let rest = str.slice(name, str.len(r.prefix), str.len(name))
    if rest == ""
        return "nothing after the prefix"
    for part in str.split(rest, r.separator)
        if part == ""
            return "empty segment"
    ""

// Whether a path segment can be part of an environment name: one or
// more ASCII letters, digits and underscores.
fn exportable(seg: Str) -> Bool
    for i in 0..str.len(seg)
        let b = str.byte_at_or(seg, i, 0)
        let letter = b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z'
        if not (letter or b >= '0' and b <= '9' or b == '_')
            return false
    str.len(seg) > 0

// An environment value's text as a value under the rule: split into a
// list when the rule has a list separator, and typed when it infers
// scalars.
fn value_for(r: EnvKeyRule, text: Str) -> ConfigValue
    match r.list_separator
        Some(sep) =>
            var items: [ConfigValue] = []
            if text != ""
                for part in str.split(text, sep)
                    list.push(items, scalar_for(r, part))
            cfgvalue.list_of(items)
        None      => scalar_for(r, text)

// One piece of text, typed when the rule infers scalars.
fn scalar_for(r: EnvKeyRule, text: Str) -> ConfigValue
    if r.infer_scalars
        return cfgvalue.infer_scalar(text)
    cfgvalue.str_value(text)

// `root` with `path` set to `v`, or `root` unchanged when the path
// does not parse.
fn with_value(root: ConfigValue, path: Str, v: ConfigValue) -> ConfigValue
    match cfglookup.with_path(root, path, v)
        Ok(t)  => t
        Err(_) => root
