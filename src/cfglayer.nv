// cfglayer.nv — a named source of values with a precedence.
//
// A layer is three things, and none of them is a file: a name, a rank
// and a tree.  Where the tree came from is the host's business.
// config-nv builds one from a TOML file, one from the environment, one
// from `.env` and one from the command line, and by the time a layer is
// here its tree is a value like any other.
//
// The name is what `cfgmerge.origin_of` answers with and what every
// refusal in `cfgfault` blames.  It should read as the place a person
// would go to change the setting, such as `"/etc/app.toml"`,
// `"APP_ environment"` or `"--set"`, rather than as a format such as
// `"toml"`, which does not say which of three TOML files won.
//
// Ranks are integers, so a program can list its layers in whatever
// order is convenient and still have them applied in the order its
// documentation promises.  The merge applies them in ascending rank,
// and equal ranks keep list order, so a caller that gives every layer
// rank 0 gets list order.
//
// Every function here is `@tier(rt)`.

use std.math
use cfgvalue

// A named source of values with a precedence.
//
// ```novo
// use cfglayer
// use cfgvalue
//
// fn main() [io]
//     let l = cfglayer.layer("defaults", 0, cfgvalue.empty_table())
//     println(l.name)
// ```
pub struct ConfigLayer
    // What a provenance answer and a refusal call this source.
    name: Str
    // Precedence.  Higher wins; equal ranks keep list order.
    rank: Int
    // The values, as a tree.  A layer whose root is not a table is
    // accepted here, and the merge leaves it out and reports it (see
    // `cfgmerge.refused_layers`).
    root: ConfigValue

// A layer.
//
// ```novo
// use cfglayer
// use cfgvalue
//
// fn main() [io]
//     let l = cfglayer.layer("/etc/app.toml", 10, cfgvalue.empty_table())
//     println("${l.rank}")
// ```
pub @tier(rt)
fn layer(name: Str, rank: Int, root: ConfigValue) -> ConfigLayer
    ConfigLayer { name: name, rank: rank, root: root }

// The same layer under a different name.
//
// For a host that built a layer before it knew the file's path.
//
// ```novo
// use cfglayer
// use cfgvalue
//
// fn main() [io]
//     let l = cfglayer.layer("file", 10, cfgvalue.empty_table())
//     println(cfglayer.renamed(l, "/etc/app.toml").name)
// ```
pub @tier(rt)
fn renamed(l: ConfigLayer, name: Str) -> ConfigLayer
    ConfigLayer { name: name, rank: l.rank, root: l.root }

// The same layer at a different rank.
//
// ```novo
// use cfglayer
// use cfgvalue
//
// fn main() [io]
//     let l = cfglayer.layer("defaults", 0, cfgvalue.empty_table())
//     println("${cfglayer.reranked(l, 5).rank}")
// ```
pub @tier(rt)
fn reranked(l: ConfigLayer, rank: Int) -> ConfigLayer
    ConfigLayer { name: l.name, rank: rank, root: l.root }

// The layers in the order the merge applies them: ascending rank,
// list order within a rank.
//
// A program that prints its sources in order prints this, and so
// prints the order the merge uses.
//
// ```novo
// use cfglayer
// use cfgvalue
// use std.list
//
// fn main() [io]
//     let a = cfglayer.layer("defaults", 0, cfgvalue.empty_table())
//     let b = cfglayer.layer("environment", 20, cfgvalue.empty_table())
//     println("${list.len(cfglayer.in_order([b, a]))}")
// ```
pub @tier(rt)
fn in_order(ls: [ConfigLayer]) -> [ConfigLayer]
    var out: [ConfigLayer] = []
    for l in ls
        out = inserted(out, l)
    out

// The layer with this name, or `None`.
//
// Names need not be unique, and this finds the first in list order.
// A program that needs them unique checks that itself.
//
// ```novo
// use cfglayer
// use cfgvalue
//
// fn main() [io]
//     let a = cfglayer.layer("defaults", 0, cfgvalue.empty_table())
//     match cfglayer.named([a], "defaults")
//         Some(l) => println(l.name)
//         None    => println("no such layer")
// ```
pub @tier(rt)
fn named(ls: [ConfigLayer], name: Str) -> ?ConfigLayer
    for l in ls
        if l.name == name
            return Some(l)
    None

// The highest rank in a list, or `0` for an empty list.
//
// A host adds one to it to put a new layer on top of everything it
// has.
//
// ```novo
// use cfglayer
// use cfgvalue
//
// fn main() [io]
//     let a = cfglayer.layer("defaults", 3, cfgvalue.empty_table())
//     println("${cfglayer.top_rank([a])}")
// ```
pub @tier(rt)
fn top_rank(ls: [ConfigLayer]) -> Int
    if list.len(ls) == 0
        return 0
    var top = ls[0].rank
    for l in ls
        top = math.max(top, l.rank)
    top

// `sorted` with `l` placed after every layer of the same or a lower
// rank, which keeps equal ranks in the order they arrived.  A plain
// insertion: a program has a handful of layers.
@tier(rt)
fn inserted(sorted: [ConfigLayer], l: ConfigLayer) -> [ConfigLayer]
    var pos = 0
    for k in 0..list.len(sorted)
        if sorted[k].rank <= l.rank
            pos = k + 1
    var out: [ConfigLayer] = []
    for k in 0..pos
        list.push(out, sorted[k])
    list.push(out, l)
    for k in pos..list.len(sorted)
        list.push(out, sorted[k])
    out
