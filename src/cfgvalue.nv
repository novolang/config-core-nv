// cfgvalue.nv — the one tree every layer is expressed in, and the
// rule for turning a string into a typed value.
//
// A merge has to compare two values that came from different formats.
// A file said `port = 8080` in TOML and the environment said
// `APP_PORT=8080` as text, and "the later layer wins" has an answer
// only when both are the same kind of thing.  One tree makes the merge
// a function of two values; a tree per format would make it a matrix.
//
// The adapters that turn a TOML, YAML or JSON document into this tree
// live in config-nv, which depends on those parsers anyway.
//
// There is no date and no time arm.  TOML has both, and this tree holds
// them as `CfgStr` in RFC 3339 spelling.  A configuration merge never
// compares two instants, and a program that wants the date parses the
// string it gets back.
//
// Every function here is `@tier(rt)`: it allocates, and it runs on a
// device with a heap.

use std.str
use std.math

// A configuration value, after parsing and before merging.
//
// There are seven arms.  `CfgNull` is a value a layer set, which is
// not the same as a key no layer mentioned.  YAML writes it `a:`, JSON
// writes it `null`, and TOML cannot write it.  A program clearing an
// inherited setting needs the difference, and `cfgfault.KeyPresence`
// is where a caller asks for it.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     let v = cfgvalue.int_value(8080)
//     println(cfgvalue.kind_name(cfgvalue.kind_of(v)))
// ```
pub enum ConfigValue
    // A table: its pairs in the order the layer wrote them.  The order
    // is kept, so a merged table renders back out the same way every
    // time.
    CfgTable(pairs: [ConfigPair])
    // A list.  A later list replaces an earlier one whole (see
    // `cfgmerge`).
    CfgList(items: [ConfigValue])
    // A string, already unescaped by whatever parsed it.
    CfgStr(value: Str)
    // A signed 64-bit integer.
    CfgInt(value: Int)
    // A 64-bit float.
    CfgFloat(value: Float)
    // `true` or `false`.
    CfgBool(value: Bool)
    // The null value: a key a layer set to nothing.  The absence of a
    // key is no arm at all.
    CfgNull

// One key and its value, in the order the layer wrote them.
//
// The key is a `Str`.  YAML permits a collection as a mapping key, and
// this tree does not, because a dotted path cannot name one.
// config-nv's YAML adapter refuses such a document.
pub struct ConfigPair
    // The key as the layer spelled it.  Lookup is case-sensitive; the
    // environment mapping in `cfgenvkeys` is the one place that
    // lowercases.
    key: Str
    // The value bound to it.
    value: ConfigValue

// Which arm a value is, as a value in its own right.
//
// A refusal says "wanted an int, found a string" with two of these,
// which a caller can match on, log or render in its own words.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println(cfgvalue.kind_name(KindBool))
// ```
pub enum ConfigKind
    KindTable
    KindList
    KindStr
    KindInt
    KindFloat
    KindBool
    KindNull

// The kind of a value.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     let k = cfgvalue.kind_of(cfgvalue.str_value("hello"))
//     println(cfgvalue.kind_name(k))
// ```
pub @tier(rt)
fn kind_of(v: ConfigValue) -> ConfigKind
    match v
        CfgTable(_) => KindTable
        CfgList(_)  => KindList
        CfgStr(_)   => KindStr
        CfgInt(_)   => KindInt
        CfgFloat(_) => KindFloat
        CfgBool(_)  => KindBool
        CfgNull     => KindNull

// The kind's name, in the spelling a refusal uses.
//
// The names are `"table"`, `"list"`, `"str"`, `"int"`, `"float"`,
// `"bool"` and `"null"`: lower case, with no punctuation, and stable
// across releases, because a program's own error text may quote them.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println(cfgvalue.kind_name(KindFloat))
// ```
pub @tier(rt)
fn kind_name(k: ConfigKind) -> Str
    match k
        KindTable => "table"
        KindList  => "list"
        KindStr   => "str"
        KindInt   => "int"
        KindFloat => "float"
        KindBool  => "bool"
        KindNull  => "null"

// A table from its pairs, in order.
//
// Duplicate keys are the caller's to avoid.  This constructor does not
// deduplicate, because which of two same-named pairs a format means is
// the format's rule.  A lookup finds the first.  The table holds its
// own copy of the list.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     let t = cfgvalue.table([cfgvalue.pair("port", cfgvalue.int_value(80))])
//     println(cfgvalue.kind_name(cfgvalue.kind_of(t)))
// ```
pub @tier(rt)
fn table(pairs: [ConfigPair]) -> ConfigValue
    CfgTable(pairs[:])

// The empty table: the root of a layer that contributes nothing, and
// the identity of the merge.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println("${cfgvalue.len_of(cfgvalue.empty_table())}")
// ```
pub @tier(rt)
fn empty_table() -> ConfigValue
    let none: [ConfigPair] = []
    CfgTable(none)

// One pair.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     let p = cfgvalue.pair("host", cfgvalue.str_value("localhost"))
//     println(p.key)
// ```
pub @tier(rt)
fn pair(key: Str, value: ConfigValue) -> ConfigPair
    ConfigPair { key: key, value: value }

// A list from its items.  The value holds its own copy of the list.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     let xs = cfgvalue.list_of([cfgvalue.int_value(1), cfgvalue.int_value(2)])
//     println("${cfgvalue.len_of(xs)}")
// ```
pub @tier(rt)
fn list_of(items: [ConfigValue]) -> ConfigValue
    CfgList(items[:])

// A string value.  It is named `str_value` rather than `str` because
// `str` is a standard library module.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println(cfgvalue.kind_name(cfgvalue.kind_of(cfgvalue.str_value("x"))))
// ```
pub @tier(rt)
fn str_value(s: Str) -> ConfigValue
    CfgStr(s)

// An integer value.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println(cfgvalue.kind_name(cfgvalue.kind_of(cfgvalue.int_value(1))))
// ```
pub @tier(rt)
fn int_value(n: Int) -> ConfigValue
    CfgInt(n)

// A float value.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println(cfgvalue.kind_name(cfgvalue.kind_of(cfgvalue.float_value(1.5))))
// ```
pub @tier(rt)
fn float_value(f: Float) -> ConfigValue
    CfgFloat(f)

// A boolean value.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println(cfgvalue.kind_name(cfgvalue.kind_of(cfgvalue.bool_value(true))))
// ```
pub @tier(rt)
fn bool_value(b: Bool) -> ConfigValue
    CfgBool(b)

// The null value.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println(cfgvalue.kind_name(cfgvalue.kind_of(cfgvalue.null_value())))
// ```
pub @tier(rt)
fn null_value() -> ConfigValue
    CfgNull

// One level of a table, by key.
//
// `None` when the value is not a table or the key is not in it.  The
// dotted-path walk in `cfglookup` is this repeated, with a reason kept
// for the level that failed.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     let t = cfgvalue.table([cfgvalue.pair("a", cfgvalue.int_value(1))])
//     match cfgvalue.field(t, "a")
//         Some(_) => println("found")
//         None    => println("absent")
// ```
pub @tier(rt)
fn field(v: ConfigValue, key: Str) -> ?ConfigValue
    match v
        CfgTable(pairs) =>
            let at = index_of_key(pairs, key)
            if at < 0
                return None
            Some(pairs[at].value)
        _               => None

// The keys of a table, in order.  `[]` for anything else.
//
// ```novo
// use cfgvalue
// use std.list
//
// fn main() [io]
//     let t = cfgvalue.table([cfgvalue.pair("a", cfgvalue.null_value())])
//     println("${list.len(cfgvalue.keys_of(t))}")
// ```
pub @tier(rt)
fn keys_of(v: ConfigValue) -> [Str]
    var out: [Str] = []
    if let CfgTable(pairs) = v
        for p in pairs
            list.push(out, p.key)
    out

// How many pairs a table has, or how many items a list has.  `0` for
// every scalar, `CfgNull` included.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println("${cfgvalue.len_of(cfgvalue.int_value(7))}")
// ```
pub @tier(rt)
fn len_of(v: ConfigValue) -> Int
    match v
        CfgTable(pairs) => list.len(pairs)
        CfgList(items)  => list.len(items)
        _               => 0

// Whether the value is a table.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println("${cfgvalue.is_table(cfgvalue.empty_table())}")
// ```
pub @tier(rt)
fn is_table(v: ConfigValue) -> Bool
    match v
        CfgTable(_) => true
        _           => false

// Whether the value is the null value.
//
// This asks about the arm.  A key nothing set never reaches a
// `ConfigValue` at all.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println("${cfgvalue.is_null(cfgvalue.null_value())}")
// ```
pub @tier(rt)
fn is_null(v: ConfigValue) -> Bool
    match v
        CfgNull => true
        _       => false

// The one place a string becomes a typed value, and the only coercion
// in the package.
//
// - `"true"` and `"false"` are `CfgBool`.
// - An optional `+` or `-` followed by one or more decimal digits is
//   `CfgInt` when it fits in 64 bits, and `CfgStr` when it does not.
// - An optional sign, digits with a decimal point or an exponent
//   (`1.5`, `.5`, `2.`, `1e3`, `6.02E+23`), and at least one digit
//   before the exponent, is `CfgFloat` when it is in the range of a
//   64-bit float, and `CfgStr` when it is not (`1e999`).
// - `"null"` is `CfgNull`.
// - Everything else, the empty string and `"True"` included, is
//   `CfgStr` with the text unchanged.
//
// Two callers need the same rule: the environment layer and
// config-nv's command-line overrides, whose values are both text.  The
// typed getters in `cfglookup` do not coerce, so `get_int` on a
// `CfgStr` is a refusal that names the layer, not a parse.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     println(cfgvalue.kind_name(cfgvalue.kind_of(cfgvalue.infer_scalar("8080"))))
//     println(cfgvalue.kind_name(cfgvalue.kind_of(cfgvalue.infer_scalar("8080a"))))
// ```
pub @tier(rt)
fn infer_scalar(text: Str) -> ConfigValue
    if text == "true"
        return CfgBool(true)
    if text == "false"
        return CfgBool(false)
    if text == "null"
        return CfgNull
    if is_integer_text(text)
        if let Some(n) = integer_value(text)
            return CfgInt(n)
        return CfgStr(text)
    if is_float_text(text)
        if let Some(f) = str.to_float(text)
            return CfgFloat(f)
    CfgStr(text)

// `infer_scalar`'s opposite: a scalar written as the text a layer
// would have held.
//
// `CfgStr` gives its own text, unquoted.  A float always carries a
// point or an exponent, so `infer_scalar` reads it back as a float:
// 30.0 is written `30.0`.  `CfgTable` and `CfgList` give `None`,
// because no one spelling of a table is common to every format.
//
// ```novo
// use cfgvalue
//
// fn main() [io]
//     match cfgvalue.scalar_text(cfgvalue.bool_value(false))
//         Some(t) => println(t)
//         None    => println("not a scalar")
// ```
pub @tier(rt)
fn scalar_text(v: ConfigValue) -> ?Str
    match v
        CfgStr(s)   => Some(s)
        CfgInt(n)   => Some(str.from_int(n))
        CfgFloat(f) => Some(float_text(f))
        CfgBool(b)  => Some(str.from_bool(b))
        CfgNull     => Some("null")
        _           => None

// Whether `text` is an optional sign and one or more decimal digits.
@tier(rt)
fn is_integer_text(text: Str) -> Bool
    let n = str.len(text)
    var i = 0
    if n > 0 and is_sign(str.byte_at_or(text, 0, 0))
        i = 1
    if i == n
        return false
    for k in i..n
        if not is_digit(str.byte_at_or(text, k, 0))
            return false
    true

// The value of text `is_integer_text` accepted, or `None` when it does
// not fit in 64 bits.  A negative number is accumulated downward, so
// the most negative `Int` fits too.
@tier(rt)
fn integer_value(text: Str) -> ?Int
    let n = str.len(text)
    let first = str.byte_at_or(text, 0, 0)
    let negative = first == '-'
    var start = 0
    if is_sign(first)
        start = 1
    let low = math.min_int()
    let high = math.max_int()
    var v = 0
    for k in start..n
        let d = str.byte_at_or(text, k, 0) - '0'
        if negative
            if v < (low + d) / 10
                return None
            v = v * 10 - d
        else
            if v > (high - d) / 10
                return None
            v = v * 10 + d
    Some(v)

// Whether `text` is a decimal float: an optional sign, digits with a
// point or an exponent, at least one digit before any exponent, and
// at least one digit in the exponent.
@tier(rt)
fn is_float_text(text: Str) -> Bool
    let n = str.len(text)
    var i = 0
    if n > 0 and is_sign(str.byte_at_or(text, 0, 0))
        i = 1
    var digits = 0
    var point = false
    var exponent = false
    var exp_digits = 0
    for k in i..n
        let b = str.byte_at_or(text, k, 0)
        if is_digit(b)
            if exponent
                exp_digits = exp_digits + 1
            else
                digits = digits + 1
        else if b == '.' and not point and not exponent
            point = true
        else if (b == 'e' or b == 'E') and not exponent and digits > 0
            exponent = true
        else if is_sign(b) and exponent and exp_digits == 0 and is_exponent_mark(str.byte_at_or(text, k - 1, 0))
            exp_digits = 0
        else
            return false
    digits > 0 and (point or exponent) and (not exponent or exp_digits > 0)

@tier(rt)
fn is_digit(b: Int) -> Bool
    b >= '0' and b <= '9'

@tier(rt)
fn is_sign(b: Int) -> Bool
    b == '+' or b == '-'

@tier(rt)
fn is_exponent_mark(b: Int) -> Bool
    b == 'e' or b == 'E'

// A float's text with a point or an exponent in it, so it reads back
// as a float.  The shortest round-trip form of a whole number has
// neither, and gets `.0`.
@tier(rt)
fn float_text(f: Float) -> Str
    let t = str.from_float(f)
    if str.contains(t, ".") or str.contains(t, "e") or str.contains(t, "n")
        return t
    t + ".0"

// The index of the first pair with this key, or -1.
@tier(rt)
fn index_of_key(pairs: [ConfigPair], key: Str) -> Int
    for i in 0..list.len(pairs)
        if pairs[i].key == key
            return i
    0 - 1
